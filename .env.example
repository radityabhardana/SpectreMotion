# =====================================================================
# SpectreMotion — configuration
# Copy this file to `.env` and edit. Relative paths resolve from repo root.
# =====================================================================

# ---- Server ----
HOST=127.0.0.1
PORT=8080
# Public base URL used to build download links. Leave empty for localhost.
PUBLIC_BASE_URL=

# ---- Data & storage (local MVP) ----
DATA_DIR=data
DB_PATH=data/app.db
UPLOAD_DIR=data/uploads
WORK_DIR=data/work
OUTPUT_DIR=data/output
TRANSCRIPT_CACHE_DIR=data/cache/transcripts
LOG_DIR=data/logs
# Max upload size in MB (0 = unlimited)
MAX_UPLOAD_MB=2048

# ---- Logging ----
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3

# ---- Adapter drivers (swap backends without touching callers) ----
QUEUE_DRIVER=sqlite
STORAGE_DRIVER=local
LLM_DRIVER=openai
TRANSCRIBER_DRIVER=faster_whisper
JOB_LEASE_SECONDS=300

# ---- Auth ----
# Single-user token for the web UI. If empty, the app runs OPEN (local only!).
# Set this to a long random string before exposing the app anywhere.
APP_TOKEN=

# ---- Telegram bot ----
# Get this from @BotFather. Required when running the bot (python -m app.bot).
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to use the bot.
# EMPTY = allow everyone (bad for a public bot). Get your id from @userinfobot.
TELEGRAM_ALLOWED_USERS=
# Polling window per run, in seconds (kept < cron interval).
BOT_POLL_SECONDS=270
BOT_LONGPOLL_TIMEOUT=30
# Reject input videos longer than this (protects a small runner).
BOT_MAX_INPUT_SECONDS=1200

# ---- Git persistence (for ephemeral GitHub Actions runs) ----
# When 1, the bot commits its SQLite state back to git so it survives runs.
# Set 0 for local runs.
GIT_PERSIST=0
GIT_PUSH=1

# ---- Transcription (faster-whisper) ----
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=
WHISPER_BEAM_SIZE=3
WHISPER_VAD_FILTER=1

# ---- LLM analysis (OpenAI-compatible endpoint) ----
LLM_BASE_URL=http://127.0.0.1:20128/v1
LLM_API_KEY=
LLM_MODEL=auto
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_S=5
AI_TRANSCRIPT_CHUNK_CHARS=12000
AI_MAX_TRANSCRIPT_CHUNKS=12

# ---- Rendering ----
TARGET_WIDTH=1080
TARGET_HEIGHT=1920
MAX_CLIPS=3
MAX_PROPOSED_CLIPS=25
MIN_CLIP_DURATION_S=1
MAX_CLIP_DURATION_S=120
FFMPEG_THREADS=2
X264_PRESET=medium
X264_CRF=21
X264_MAXRATE=8M
X264_BUFSIZE=16M
AUDIO_LOUDNORM_FILTER=loudnorm=I=-16:TP=-1.5:LRA=11

# ---- Subtitles / hook ----
SUBTITLE_FONT_NAME=DejaVu Sans Bold
# Windows example: C:/Windows/Fonts/arialbd.ttf
# Linux example:   /usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
SUBTITLE_FONT_PATH=
TEMPLATE_PATH=templates/default_hook.json

# ---- Worker ----
WORKER_POLL_INTERVAL_S=3
WORKER_ONCE=0
