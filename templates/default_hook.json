{
  "name": "Default Hook",
  "hook": {
    "font_name": "DejaVu Sans Bold",
    "font_size": 64,
    "font_color": "#FFFFFF",
    "highlight_color": "#00FF66",
    "box": true,
    "box_color": "#000000",
    "box_opacity": 0.55,
    "box_border_w": 18,
    "x": "(w-text_w)/2",
    "y": "h*0.12",
